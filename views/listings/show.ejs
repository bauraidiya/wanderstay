<% layout("/layouts/boilerplate.ejs") %>
<script>
   const mapToken = "<%= mapToken %>";
   const listing = <%- JSON.stringify(allData) %>;
</script>

    <div class="row ">
        <div class="col-8 offset-2 mt-3">
    <h3><%= allData.title %> </h3>
    </div>
    <div class="show-card col-6 offset-3">
        <img src="<%=allData.image.url %>" class="card-img-top show-img" alt="listing_Image">
    <div class="card-body listing-card">
            <p class="card-text">owned by <i><%= allData.owner.username%></i></p>
            <p class="card-text" ><%= allData.description%></p>
            <p class="card-text">Price:- &#8377; <%= allData.price ? allData.price.toLocaleString("en-IN") : "N/A" %> / Night</p>
            <p class="card-text">Location:- <%= allData.location %></p>
            <p class="card-text">Country:- <%= allData.country %></p>           
  </div> 
  <br>
   <% if(currentUser && allData.owner._id.equals(currentUser._id)) {%>
    <div class="btns">
         <a href="/listing/<%= allData._id %>/edit" class="btn  col-2 offset-2 show-btns mt-2 mb-2">  Edit  </a>

        <form method="post" action="/listing/<%= allData._id %>?_method=DELETE" class="btn  col-2 offset-4 mt-2 mb-2 del">
        <button><b> Delete</b></button>
    </form>
   </div>
   <% } %>
  <hr>
   <% if(currentUser) {%>
   <div>
    <h4><b>Leave a review</b></h4>
    <form action="/listing/<%= allData._id%>/reviews" method="POST" class="needs-validation" novalidate>
        
        <div class="mb-3 mt-3">
            <label for="rating" class="form-lable mb-2"><b>Rating</b></label>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                <label for="second-rate1" title="Terrible">1 star</label>
                <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                <label for="second-rate2" title="Not good">2 stars</label>
                <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                <label for="second-rate3" title="Average">3 stars</label>
                <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                <label for="second-rate4" title="Very good">4 stars</label>
                <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                <label for="second-rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label"><b>Comments</b></label>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control " required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        <button class="btn btn-outline-dark mb-3">Submit</button>
        <hr>
    </form>
    <% } %>

        <% if(allData.reviews.length>0){ %>
        <div class="row">
            <p><b>All Review</b></p>
        <% for( review of allData.reviews) {%>
            <div class="card col-6 mb-2 ms-0.5">
                <div class="card-body ">
                    <h5 class="card-title"><b><%= review.author.username %></b></h5>
                    <p class="starability-result card-text" data-rating=<%= review.rating%>></p>
                    <p class="card-text"><%= review.comment%></p>
        
                </div>
                <form class="mb-3" method="post" action="/listing/<%= allData._id%>/reviews/<%=review._id%>?_method=DELETE">
                    <button class="btn btn-dark">Delete</button>
                </form>
            </div>
            <%}%>
   </div>
        <% } %>
    </div>
    <div class="col-6 offset-3 mb-3">
    <hr>
    <h3>Where you'll be</h3>
    <div id="map"></div>
</div>
</div>
<script src="/js/map.js"></script>